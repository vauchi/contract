<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 Mattia Egloff <mattia.egloff@pm.me>
SPDX-License-Identifier: AGPL-3.0-or-later

An explicit source list, so a restore does not depend on the account's
NuGet.Config: a freshly provisioned runner has none (windows job
16461294262 failed NU1100 for every package).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
